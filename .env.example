# =========================================================================
# 一体化 AI 服务平台 - 环境变量示例
# 复制为 .env 后按需修改；所有 *_FILE 变量指向 Docker secrets 路径
# =========================================================================

# ---- 访问模式 ----
ACCESS_MODE=path                # path | subdomain
DOMAIN=example.com              # 主域名（证书与 server_name）
HOST_IP=                        # 导航页端口链接用 IP/域名，留空自动探测

# ---- 服务开关 ----
ENABLE_DSH=true
ENABLE_OPENCLAW=true
ENABLE_HERMES=true
ENABLE_ADMIN=true

# ---- 端口网关（开发调试，默认全关）----
ENABLE_DSH_PORT=false
ENABLE_OPENCLAW_PORT=false
ENABLE_HERMES_PORT=false
ENABLE_ADMIN_PORT=false

# ---- SSH（默认关闭；开启时公钥必填）----
ENABLE_SSH=false
SSH_PORT=22
SSH_USER=aioadm
SSH_AUTHORIZED_KEYS=            # 直接粘贴公钥，或用下行 _FILE
# SSH_AUTHORIZED_KEYS_FILE=/run/secrets/ssh_pub
ENABLE_FAIL2BAN=false

# ---- 证书（ACME_EMAIL 留空则跳过 ACME，用自签兜底）----
ACME_EMAIL=
ACME_STAGING=true               # 调试期保持 true，确认后改 false
# DNS-01 提供商: cloudflare | route53 | google | digitalocean | dnspod | aliyun | custom
ACME_DNS_PROVIDER=
# CF_DNS_API_TOKEN_FILE=/run/secrets/cf_token              # cloudflare
# AWS_ACCESS_KEY_ID_FILE=/run/secrets/aws_key_id           # route53
# AWS_SECRET_ACCESS_KEY_FILE=/run/secrets/aws_secret
# GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/gcp_sa.json  # google（服务账号 JSON）
# DO_DNS_TOKEN_FILE=/run/secrets/do_token                  # digitalocean
# DNSPOD_TOKEN_FILE=/run/secrets/dnspod_token              # dnspod，内容格式 "ID,TOKEN"
# ALIYUN_ACCESS_KEY_ID_FILE=/run/secrets/ali_key_id        # aliyun
# ALIYUN_ACCESS_KEY_SECRET_FILE=/run/secrets/ali_secret
# custom: 挂载自定义 hook（参考 examples/dns-hooks/）:
#   -v ./my-hooks/custom-auth.sh:/etc/aio/dns-hooks/custom-auth.sh:ro
#   -v ./my-hooks/custom-cleanup.sh:/etc/aio/dns-hooks/custom-cleanup.sh:ro
DNS_PROPAGATION_SECONDS=40      # manual hook 等待解析生效秒数
# 或挂载外部证书（设置后完全跳过 ACME）:
# TLS_CERT_FILE=/run/secrets/fullchain.pem
# TLS_KEY_FILE=/run/secrets/privkey.pem

# ---- 管理口 / 端口网关鉴权（启用对应入口时必填）----
ADMIN_USER=admin
ADMIN_PASSWORD=
# ADMIN_PASSWORD_FILE=/run/secrets/admin_pw
ALLOWED_IPS=                    # 逗号分隔 CIDR，留空放行所有（日志告警）

# ---- 业务密钥（按上游服务要求注入，均支持 _FILE）----
# DEEPSEEK_API_KEY=
# DEEPSEEK_API_KEY_FILE=/run/secrets/ds_key

# ---- 服务启动命令（可配置 CLI；留空用 entrypoint 默认值）----
# 要求: 命令必须监听固定端口 dsh=3080 / openclaw=18789 / hermes=6060 / admin=34567
# DSH_COMMAND=/opt/dsh/venv/bin/gunicorn --bind 127.0.0.1:3080 --workers 2 --timeout 600 dsh.app:app
# OPENCLAW_COMMAND=/usr/local/bin/node /opt/openclaw/dist/index.js
# HERMES_COMMAND=/usr/local/bin/node /opt/hermes/dist/index.js --host 127.0.0.1 --port 6060
# ADMIN_COMMAND=/usr/local/bin/node /opt/admin/dist/index.js --host 127.0.0.1 --port 34567

# ---- 系统 ----
PROXY_READ_TIMEOUT=600          # LLM 长请求超时（秒）
PUID=1000
PGID=1000
TZ=Asia/Shanghai
LOG_LEVEL=info
