# 管理工具端口网关：0.0.0.0:34567 → 127.0.0.1:34567（高危入口，强制鉴权）
server {
    listen ${GATEWAY_IP}:34567;

    auth_basic "AIO Admin Direct";
    auth_basic_user_file /etc/nginx/.htpasswd;
    include /etc/nginx/snippets/allowed-ips.conf;

    location / {
        proxy_pass http://127.0.0.1:34567;
        include /etc/nginx/snippets/proxy-headers.conf;
        include /etc/nginx/snippets/ws.conf;
        proxy_read_timeout 300s;
    }
}
