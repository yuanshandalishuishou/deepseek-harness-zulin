# DSH 端口网关：0.0.0.0:3080 → 127.0.0.1:3080（直通，零路径改写）
# 业务进程绑 127.0.0.1:3080，与本 server 同号不同址，可共存
server {
    listen ${GATEWAY_IP}:3080;

    auth_basic "DSH Direct";
    auth_basic_user_file /etc/nginx/.htpasswd;
    include /etc/nginx/snippets/allowed-ips.conf;

    location / {
        proxy_pass http://127.0.0.1:3080;
        include /etc/nginx/snippets/proxy-headers.conf;
        include /etc/nginx/snippets/ws.conf;
        proxy_buffering off;                     # 直连模式全量透传流式响应
        proxy_read_timeout ${PROXY_READ_TIMEOUT}s;
    }
}
