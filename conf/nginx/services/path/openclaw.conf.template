# OpenClaw（路径模式）：官方 basepath 机制（supervisor 已注入
# OPENCLAW_GATEWAY_CONTROLUI_BASEPATH=/openclaw），Nginx 剥离前缀直通
location /openclaw/ {
    proxy_pass http://127.0.0.1:18789/;
    include /etc/nginx/snippets/proxy-headers.conf;
    include /etc/nginx/snippets/ws.conf;
    proxy_set_header X-Forwarded-Prefix /openclaw;
    proxy_redirect / /openclaw/;
    proxy_cookie_path / /openclaw/;
    proxy_read_timeout ${PROXY_READ_TIMEOUT}s;
}

location = /healthz/openclaw {
    proxy_pass http://127.0.0.1:18789/;
    proxy_connect_timeout 3s;
    proxy_read_timeout 3s;
    access_log off;
}
