; DeepSeek Harness 服务程序
; 启动命令由环境变量 DSH_COMMAND 注入（见 .env.example），默认值在 entrypoint.sh
; 要求: 命令必须监听 127.0.0.1:3080
[program:dsh]
command=${DSH_COMMAND}
directory=/opt/dsh
priority=20
user=dsh
autorestart=true
stopasgroup=true
killasgroup=true
stopwaitsecs=10
environment=LOG_LEVEL="${LOG_LEVEL}",DEEPSEEK_API_KEY="${DEEPSEEK_API_KEY}"
stdout_logfile=/dev/fd/1
stdout_logfile_maxbytes=0
redirect_stderr=true
