; Hermes Agent 服务程序
; 启动命令由环境变量 HERMES_COMMAND 注入，默认值在 entrypoint.sh
; 要求: 命令必须监听 127.0.0.1:6060
[program:hermes]
command=${HERMES_COMMAND}
directory=/opt/hermes
priority=20
user=hermes
autorestart=true
stopasgroup=true
killasgroup=true
stopwaitsecs=10
environment=LOG_LEVEL="${LOG_LEVEL}"
stdout_logfile=/dev/fd/1
stdout_logfile_maxbytes=0
redirect_stderr=true
