{
  // OpenClaw 主配置（镜像零密钥：DEEPSEEK_API_KEY 由容器运行时通过 ~/.openclaw/.env 注入）
  "agents": {
    "defaults": {
      "workspace": "/root/.openclaw/workspace",
      "model": {
        "primary": "deepseek/deepseek-v4-pro",
        "fallbacks": ["deepseek/deepseek-v4-flash"]
      },
      // 已自带工作区文件，禁止 bootstrap 覆盖
      "skipBootstrap": true
    }
  },
  "gateway": {
    "port": 18789
  }
}
